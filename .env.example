# ==============================================
# ShivariVel Construction & Interiors
# Environment Variables
# ==============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ==============================================

# ---- Browser (Frontend) Variables ----
# These are exposed to the browser via Vite's import.meta.env
# Prefix: VITE_

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Server-Only Variables ----
# These must NEVER be imported into React/browser code.
# Used only by Supabase CLI, CI/CD, Edge Functions, or admin scripts.

# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=
# SUPABASE_ACCESS_TOKEN=
# BACKUP_BUCKET_KEY=
